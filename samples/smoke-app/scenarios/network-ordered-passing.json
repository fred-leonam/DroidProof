    ]
  },
  "steps": [
    {"type":"typeTextUiNode","resourceId":"io.github.fredleonam.droidproof.smokeapp:id/name","text":"Catalog42"},
    {"type":"tapUiNode","resourceId":"io.github.fredleonam.droidproof.smokeapp:id/order_action"},
    {"type":"assertUiNode","resourceId":"io.github.fredleonam.droidproof.smokeapp:id/status","text":"Order catalog-42 created","deadlineMillis":15000,"pollIntervalMillis":250}
  ]
